# Bu dosyayı .env olarak kopyalayın ve doldurun:  cp .env.example .env
# .env dosyası asla git'e / başka birine gönderilmemelidir.

# paper | demo | live   (config.yaml içindeki "mode" değerini ezer)
BOT_MODE=paper

# Binance USDⓈ-M Futures API anahtarları
#  - demo modu için: https://demo.binance.com  -> API Management (demo anahtarları)
#  - live modu için: gerçek hesap API anahtarı (sadece "Futures" izni, "Withdraw" KAPALI, IP kısıtlaması önerilir)
BINANCE_API_KEY=
BINANCE_API_SECRET=

# Telegram: @BotFather ile bot oluşturun, token'ı buraya yazın.
# Chat ID: bota bir mesaj atın, sonra https://api.telegram.org/bot<TOKEN>/getUpdates adresinden "chat":{"id":...} değerini alın.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Redis (kısa süreli hafıza / anlık durum). Docker compose içinde otomatik ayarlanır.
REDIS_URL=redis://localhost:6379/0

# PostgreSQL (işlem günlüğü + analiz). Docker compose içinde otomatik ayarlanır.
POSTGRES_USER=smcbot
POSTGRES_PASSWORD=change-me
POSTGRES_DB=smcbot
DATABASE_URL=postgresql://smcbot:change-me@localhost:5432/smcbot
